# Local docker compose only. Copy to .env and set a value.
POSTGRES_USER=khetkavach
POSTGRES_PASSWORD=
POSTGRES_DB=khetkavach
# Admin and job endpoints (X-Admin-Key). Empty = those endpoints always 401.
ADMIN_KEY=
# Telegram webhook secret (X-Telegram-Bot-Api-Secret-Token). Empty = webhook always 401.
TELEGRAM_WEBHOOK_SECRET=
