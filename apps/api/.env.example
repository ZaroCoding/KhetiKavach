# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@localhost:5432/khetkavach
DATABASE_URL=
# Checked against X-Admin-Key (admin and job endpoints). Empty = those endpoints always 401.
ADMIN_KEY=
# Checked against X-Telegram-Bot-Api-Secret-Token on the webhook. Empty = always 401.
TELEGRAM_WEBHOOK_SECRET=
