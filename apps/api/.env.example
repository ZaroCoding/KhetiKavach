# Copy to apps/api/.env for local runs. Names only: never commit real values.
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://khetkavach:<password>@localhost:5432/khetkavach
ADMIN_KEY=
# Google AI Studio key; the alias tracks the current Flash model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional LLM backup
GROQ_API_KEY=
# Copernicus Data Space OAuth client (Sentinel Hub Statistical API)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
SATELLITE_PRIMARY=sentinel_hub
# Telegram bot (@BotFather) and a webhook secret of your choosing
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
